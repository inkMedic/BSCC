<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>BallisticaCommunity</string>
<key>CFBundleIdentifier</key><string>${COMMUNITY_BUNDLE_ID}</string>
<key>CFBundleName</key><string>炸弹小分队</string>
<key>CFBundleDisplayName</key><string>炸弹小分队</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>1.8.5</string>
<key>CFBundleVersion</key><string>23079</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>MinimumOSVersion</key><string>16.0</string>
<key>CADisableMinimumFrameDurationOnPhone</key><true/>
<key>UILaunchScreen</key><dict/>
<key>UIRequiresFullScreen</key><true/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
<key>UIStatusBarHidden</key><true/>
<key>UIViewControllerBasedStatusBarAppearance</key><false/>
<key>NSLocalNetworkUsageDescription</key><string>用于发现和连接局域网游戏房间。</string>
<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
<key>CommunityAPIURL</key><string>${COMMUNITY_API_URL_XML}</string>
<key>CommunityAllowHTTP</key><${COMMUNITY_HTTP_PLIST}/>
</dict></plist>
